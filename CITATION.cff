preferred-citation:
  type: article
  title: "Atomic Task Graph: A Unified Framework for Agentic Planning and Execution"
  authors:
    - family-names: Zhang
      given-names: Yue
    - family-names: Chen
      given-names: Sihan
    - family-names: Huang
      given-names: Ziwen
    - family-names: Cui
      given-names: Hanyun
    - family-names: Ji
      given-names: Kangye
    - family-names: Wang
      given-names: Zhi
  year: 2026
  month: 7
  journal: arXiv
  identifiers:
    - type: arxiv
      value: "2607.01942"
    - type: doi
      value: 10.48550/arXiv.2607.01942
  url: https://arxiv.org/abs/2607.01942
  abstract: >-
    LLM-based agents have shown strong potential for solving complex multi-step
    tasks. The authors propose Atomic Task Graph (ATG), a unified control
    framework for planning and execution that maintains an explicit graph to
    expose dependencies, support reuse, parallel execution, and localized repair.
